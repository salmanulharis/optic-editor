{
  "id": "lc-chrome",
  "name": "Chrome",
  "group": "Leica-inspired",
  "version": 2,
  "description": "Muted chrome palette with deep shadows and cool undertones.",
  "tags": [
    "chrome",
    "muted",
    "street"
  ],
  "includes": [
    "light",
    "look",
    "curve",
    "hsl",
    "colorGrading",
    "presence"
  ],
  "settings": {
    "light": {
      "contrast": 10,
      "highlights": 0,
      "shadows": 0,
      "whites": 0,
      "blacks": 0
    },
    "look": {
      "highlightRolloff": 35,
      "shadowDensity": 70,
      "microContrast": 50,
      "colorDensity": 40,
      "warmthBias": -2
    },
    "curve": {
      "rgb": [
        {
          "x": 0,
          "y": 0
        },
        {
          "x": 0.25,
          "y": 0.205
        },
        {
          "x": 0.5,
          "y": 0.5
        },
        {
          "x": 0.75,
          "y": 0.78
        },
        {
          "x": 1,
          "y": 1
        }
      ]
    },
    "hsl": {
      "bands": {
        "red": {
          "hue": 0,
          "sat": -8,
          "lum": 0
        },
        "orange": {
          "hue": 0,
          "sat": 0,
          "lum": 0
        },
        "yellow": {
          "hue": 0,
          "sat": 0,
          "lum": 0
        },
        "green": {
          "hue": 0,
          "sat": 0,
          "lum": 0
        },
        "aqua": {
          "hue": 0,
          "sat": 0,
          "lum": 0
        },
        "blue": {
          "hue": -6,
          "sat": -15,
          "lum": 0
        },
        "purple": {
          "hue": 0,
          "sat": 0,
          "lum": 0
        },
        "magenta": {
          "hue": 0,
          "sat": 0,
          "lum": 0
        }
      }
    },
    "colorGrading": {
      "shadows": {
        "hue": 200,
        "sat": 8,
        "lum": 0
      },
      "midtones": {
        "hue": 0,
        "sat": 0,
        "lum": 0
      },
      "highlights": {
        "hue": 70,
        "sat": 5,
        "lum": 0
      },
      "global": {
        "hue": 0,
        "sat": 0,
        "lum": 0
      },
      "blending": 50,
      "balance": 0
    },
    "presence": {
      "vibrance": -4,
      "saturation": -15,
      "protectSkin": false
    }
  }
}
