{
  "id": "lc-contemporary",
  "name": "Contemporary",
  "group": "Leica-inspired",
  "version": 2,
  "description": "Modern, crisp rendering with deep blacks and clean colour.",
  "tags": [
    "modern",
    "crisp",
    "street"
  ],
  "includes": [
    "light",
    "look",
    "curve",
    "colorGrading",
    "calibration",
    "presence"
  ],
  "settings": {
