      "contrast": 12,
      "highlights": 0,
      "shadows": 0,
      "whites": 0,
      "blacks": -4
    },
    "look": {
      "highlightRolloff": 35,
      "shadowDensity": 55,
      "microContrast": 50,
      "colorDensity": 30,
      "warmthBias": 0
    },
    "curve": {
      "rgb": [
        {
          "x": 0,
          "y": 0
        },
        {
          "x": 0.25,
          "y": 0.22
        },
        {
          "x": 0.5,
          "y": 0.5
        },
        {
          "x": 0.75,
          "y": 0.77
        },
        {
          "x": 1,
          "y": 1
        }
      ]
    },
    "colorGrading": {
      "shadows": {
        "hue": 230,
        "sat": 5,
        "lum": 0
      },
      "midtones": {
        "hue": 0,
        "sat": 0,
        "lum": 0
      },
      "highlights": {
        "hue": 0,
        "sat": 0,
        "lum": 0
      },
      "global": {
        "hue": 0,
        "sat": 0,
        "lum": 0
      },
      "blending": 50,
      "balance": 0
    },
    "calibration": {
      "red": {
        "hue": 0,
        "sat": 10
      },
      "green": {
        "hue": 0,
        "sat": 0
      },
      "blue": {
        "hue": -5,
        "sat": -6
      },
      "shadowTint": 0,
      "matrix": null
    },
    "presence": {
      "vibrance": 5,
      "saturation": 5,
      "protectSkin": false
    }
  }
