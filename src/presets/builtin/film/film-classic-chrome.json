{
  "id": "film-classic-chrome",
  "name": "Classic Chrome-like",
  "group": "Film",
  "version": 3,
  "description": "Muted, documentary slide palette with hard shadows.",
  "tags": [
    "film",
    "muted",
    "documentary"
  ],
  "includes": [
    "light",
    "look",
    "curve",
    "hsl",
    "colorGrading",
    "presence",
    "grain",
    "vignette"
