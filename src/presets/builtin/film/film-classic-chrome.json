      "highlights": 0,
      "shadows": 0,
      "whites": 0,
      "blacks": 0
    },
    "look": {
      "highlightRolloff": 35,
      "shadowDensity": 50,
      "microContrast": 25,
      "colorDensity": 40,
      "warmthBias": 0
    },
    "curve": {
      "rgb": [
        {
          "x": 0,
          "y": 0
        },
        {
          "x": 0.25,
          "y": 0.202
        },
        {
          "x": 0.5,
          "y": 0.5
        },
        {
          "x": 0.75,
          "y": 0.782
        },
        {
          "x": 1,
          "y": 1
        }
      ]
    },
    "hsl": {
      "bands": {
        "red": {
          "hue": 4,
          "sat": -10,
          "lum": 0
        },
        "orange": {
          "hue": 0,
          "sat": 0,
          "lum": 0
        },
        "yellow": {
          "hue": 0,
          "sat": 0,
          "lum": 0
        },
        "green": {
          "hue": 0,
          "sat": -15,
          "lum": 0
        },
        "aqua": {
          "hue": 0,
          "sat": 0,
          "lum": 0
        },
        "blue": {
          "hue": -8,
          "sat": -15,
          "lum": 0
        },
        "purple": {
          "hue": 0,
          "sat": 0,
          "lum": 0
        },
        "magenta": {
          "hue": 0,
          "sat": 0,
          "lum": 0
