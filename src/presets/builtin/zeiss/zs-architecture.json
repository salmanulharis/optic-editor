{
  "id": "zs-architecture",
  "name": "Architecture",
  "group": "Zeiss-inspired",
  "version": 2,
  "description": "Crisp, desaturated and graphic for buildings and lines.",
  "tags": [
    "architecture",
    "graphic",
    "clean"
  ],
  "includes": [
    "light",
    "look",
    "curve",
    "hsl",
    "presence"
  ],
  "settings": {
    "light": {
      "contrast": 16,
      "highlights": 0,
      "shadows": 0,
      "whites": 0,
      "blacks": -10
    },
    "look": {
      "highlightRolloff": 15,
      "shadowDensity": 30,
      "microContrast": 65,
      "colorDensity": 10,
      "warmthBias": -8
    },
    "curve": {
      "rgb": [
        {
          "x": 0,
          "y": 0
        },
        {
          "x": 0.25,
          "y": 0.22
        },
        {
          "x": 0.5,
          "y": 0.5
        },
        {
          "x": 0.75,
          "y": 0.77
        },
        {
          "x": 1,
          "y": 1
        }
      ]
    },
    "hsl": {
      "bands": {
        "red": {
          "hue": 0,
          "sat": 0,
          "lum": 0
        },
        "orange": {
          "hue": 0,
          "sat": -10,
          "lum": 0
        },
        "yellow": {
          "hue": 0,
          "sat": -10,
          "lum": 0
        },
        "green": {
          "hue": 0,
          "sat": 0,
          "lum": 0
        },
        "aqua": {
          "hue": 0,
          "sat": 0,
          "lum": 0
        },
        "blue": {
          "hue": 0,
          "sat": 0,
          "lum": 0
        },
        "purple": {
          "hue": 0,
          "sat": 0,
          "lum": 0
        },
        "magenta": {
          "hue": 0,
          "sat": 0,
          "lum": 0
        }
      }
    },
    "presence": {
      "vibrance": 0,
      "saturation": -12,
      "protectSkin": false
    }
  }
}
