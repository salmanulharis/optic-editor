{
  "id": "zs-planar-pop",
  "name": "Planar Pop",
  "group": "Zeiss-inspired",
  "version": 2,
  "description": "High micro-contrast and clean saturated colour.",
  "tags": [
    "pop",
    "clarity",
    "vivid"
  ],
  "includes": [
    "light",
    "look",
    "curve",
    "calibration",
    "presence"
  ],
  "settings": {
    "light": {
      "contrast": 15,
      "highlights": 0,
      "shadows": 0,
      "whites": 0,
      "blacks": -8
    },
    "look": {
      "highlightRolloff": 15,
      "shadowDensity": 25,
      "microContrast": 70,
      "colorDensity": 20,
      "warmthBias": -4
    },
    "curve": {
      "rgb": [
        {
          "x": 0,
          "y": 0
        },
        {
          "x": 0.25,
          "y": 0.22
        },
        {
          "x": 0.5,
          "y": 0.5
        },
        {
          "x": 0.75,
          "y": 0.77
        },
        {
          "x": 1,
          "y": 1
        }
      ]
    },
    "calibration": {
      "red": {
        "hue": 0,
        "sat": 0
      },
      "green": {
        "hue": 0,
        "sat": 10
      },
      "blue": {
        "hue": 0,
        "sat": 12
      },
      "shadowTint": 0,
      "matrix": null
    },
    "presence": {
      "vibrance": 15,
      "saturation": 0,
      "protectSkin": false
    }
  }
}
