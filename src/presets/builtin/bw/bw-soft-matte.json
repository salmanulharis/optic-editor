{
  "id": "bw-soft-matte",
  "name": "Soft Matte",
  "group": "Black & White",
  "version": 3,
  "description": "Low-contrast monochrome with lifted, matte blacks.",
  "tags": [
    "bw",
    "matte",
    "soft"
  ],
  "includes": [
    "light",
    "look",
    "curve",
    "bw",
    "grain",
    "glow"
  ],
  "settings": {
    "light": {
      "contrast": -15,
      "highlights": 0,
      "shadows": 0,
      "whites": 0,
      "blacks": 0
    },
    "look": {
      "highlightRolloff": 70,
      "shadowDensity": 0,
      "microContrast": 10,
      "colorDensity": 0,
      "warmthBias": 0
    },
    "curve": {
      "rgb": [
        {
          "x": 0,
          "y": 0.08
        },
        {
          "x": 0.25,
          "y": 0.305
        },
        {
          "x": 0.5,
          "y": 0.51
        },
        {
          "x": 0.75,
          "y": 0.725
        },
        {
          "x": 1,
          "y": 0.94
        }
      ]
    },
    "treatment": "monochrome",
    "bwMixer": {
      "mix": 100,
      "red": 0,
      "orange": 0,
      "yellow": 0,
      "green": 0,
      "aqua": 0,
      "blue": 0,
      "purple": 0,
      "magenta": 0
    },
    "effects": {
      "grain": {
        "amount": 20,
        "size": 22,
        "roughness": 45,
        "color": 0,
        "type": "custom"
      },
      "bloom": {
        "amount": 10,
        "threshold": 70,
        "radius": 50,
        "warmth": 0
      }
    }
  }
}
